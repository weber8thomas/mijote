# ——— Obligatoire ———
# Phrase secrète du foyer, demandée une fois sur chaque téléphone (8 caractères au moins).
HOUSEHOLD_PASSPHRASE=une-phrase-longue-et-facile-a-dire
# Adresse publique de Mijoté, en https : les cookies de session sont alors sécurisés.
PUBLIC_URL=https://mijote.mondomaine.fr
# Avec le profil with-caddy : le nom de domaine (sans https://).
MIJOTE_DOMAIN=mijote.mondomaine.fr

# ——— Home Assistant (facultatif) ———
# Adresse de HA vue depuis le serveur (réseau local, pas besoin de https ni de CORS).
HA_URL=http://homeassistant.local:8123
# Profil HA → Sécurité → Jetons d'accès longue durée. Il reste sur le serveur.
HA_TOKEN=
# Liste « À faire » partagée : liste locale (todo.mijote_courses) ou Google Keep (todo.google_keep_courses).
HA_TODO_ENTITY=todo.mijote_courses
HA_SYNC_SECONDS=30

# ——— Claude (facultatif) ———
# console.anthropic.com → API Keys. Une clé dédiée, avec une limite de dépense.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Demandes par jour, pour tout le foyer.
AI_DAILY_LIMIT=20

# Fuseau horaire (semaine, « aujourd'hui », sauvegardes).
TZ=Europe/Paris
